{
  "name": "retronaut",
  "productName": "Retronaut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build.mjs",
    "start": "electron .",
    "engine": "node scripts/build.mjs && node dist/engine.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo:book": "node demo/make-book.mjs",
    "demo:reset": "node demo/reset.mjs",
    "postinstall": "node scripts/name-dev-app.mjs"
  },
  "dependencies": {
    "@factory/droid-sdk": "0.10.0",
    "@fontsource-variable/inter": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "imapflow": "2.2.10",
    "mailparser": "3.9.36",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
